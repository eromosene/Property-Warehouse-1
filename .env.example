# Copy to .env.local (local dev) and set the same values in Vercel → Project → Settings → Environment Variables.

# Backend the /api/* proxy forwards to.
API_PROXY_TARGET=https://property-warehouse-1.onrender.com

# Property Warehouse team WhatsApp business number (digits only, international format).
# All enquiry buttons on the site open a chat with this number.
NEXT_PUBLIC_PW_WHATSAPP_NUMBER=
