# Copy this file to .env and fill in real values before running the backend.

# --- Database ---
# Supabase Postgres connection string — use the "Session pooler" string from
# Project Settings > Database > Connection string (NOT the transaction pooler on :6543;
# migrations/DDL need the session pooler on :5432). Include ?sslmode=require.
# Example: postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Auth ---
# Secret used to sign the httpOnly session JWT cookie. REQUIRED — the server refuses to start
# if this is left unset or equal to the placeholder below (see src/utils/jwt.js). Generate a
# real value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_ME_WITH_YOUR_OWN_RANDOM_SECRET
# How long an issued session stays valid.
JWT_EXPIRES_IN="7d"

# --- Seeded admin account ---
# REQUIRED — replaces the hardcoded ADMIN_EMAIL/ADMIN_PASSWORD constants that used to live in
# admin.js. The seed script (src/db/seed.js) creates one admin user from these values on first
# run, and now refuses to run at all if either is missing — there is no default. Change these
# before deploying anywhere real.
ADMIN_EMAIL="admin@propertywarehouse.ng"
ADMIN_PASSWORD="PWAdmin2025!"

# --- Server ---
PORT=4000
# Origin(s) the frontend is served from, for CORS. The static frontend runs on port 5000
# per .replit (npx serve . -l 5000) — keep this in sync if that changes.
FRONTEND_ORIGIN="http://localhost:5000"
NODE_ENV="development"

# --- Uploads (Supabase Storage) ---
# Project URL and service_role key from Project Settings > API. service_role bypasses Row Level
# Security — used server-side only (src/utils/storage.js), never exposed to the frontend.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME_WITH_YOUR_SERVICE_ROLE_KEY"
# Public bucket for listing photos — served back as real public URLs.
SUPABASE_IMAGES_BUCKET="listings"
# Private bucket for ownership documents (verification-only, never rendered by the app).
SUPABASE_DOCUMENTS_BUCKET="listing-documents"
MAX_UPLOAD_MB=10
